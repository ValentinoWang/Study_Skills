{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valentinowang.github.io/Study_Skills/schema/figure-v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "kind",
    "question",
    "takeaway",
    "reading_order",
    "boundary",
    "evidence_type",
    "bindings"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "kind": {
      "enum": [
        "sequence",
        "comparison",
        "ownership"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "takeaway": {
      "type": "string",
      "minLength": 1
    },
    "reading_order": {
      "type": "string",
      "minLength": 1
    },
    "boundary": {
      "type": "string",
      "minLength": 1
    },
    "evidence_type": {
      "enum": [
        "teaching-example",
        "schematic"
      ]
    },
    "bindings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "definition_id",
          "meaning",
          "source",
          "example"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "definition_id": {
            "type": "string",
            "minLength": 1
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "example": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "actors": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "type": {
            "enum": [
              "message",
              "compare_write",
              "atomic_credit",
              "note"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "actor": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "payload": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "integer",
                "number",
                "boolean"
              ]
            }
          },
          "after": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": [
              "string",
              "integer",
              "number"
            ]
          },
          "value": {
            "type": [
              "string",
              "integer",
              "number"
            ]
          },
          "business_key": {
            "type": "string",
            "minLength": 1
          },
          "amount": {
            "type": "integer",
            "minimum": 1
          },
          "verified": {
            "const": true
          },
          "fault": {
            "enum": [
              "before_commit",
              "response_lost"
            ]
          },
          "result_of": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "message"
                }
              }
            },
            "then": {
              "required": [
                "from",
                "to"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "compare_write"
                }
              }
            },
            "then": {
              "required": [
                "actor",
                "field",
                "expected",
                "value"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "atomic_credit"
                }
              }
            },
            "then": {
              "required": [
                "actor",
                "business_key",
                "amount",
                "verified"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "note"
                }
              }
            },
            "then": {
              "required": [
                "actor"
              ]
            }
          }
        ]
      }
    },
    "initial_state": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer"
        ]
      }
    },
    "expected_final": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer"
        ]
      }
    },
    "titles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before",
        "after"
      ],
      "properties": {
        "before": {
          "type": "string",
          "minLength": 1
        },
        "after": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "before",
          "after"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "before": {
            "type": [
              "string",
              "number"
            ]
          },
          "after": {
            "type": [
              "string",
              "number"
            ]
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "children"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "children": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "sequence"
          }
        }
      },
      "then": {
        "required": [
          "actors",
          "events"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "comparison"
          }
        }
      },
      "then": {
        "required": [
          "titles",
          "rows"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "ownership"
          }
        }
      },
      "then": {
        "required": [
          "groups"
        ]
      }
    }
  ]
}
