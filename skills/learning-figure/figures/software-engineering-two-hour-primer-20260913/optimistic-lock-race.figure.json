{
  "schema_version": "2.0",
  "evidence_type": "teaching-example",
  "id": "optimistic-lock-race",
  "kind": "sequence",
  "question": "两人都读到版本 7，为什么只有一个保存成功？",
  "takeaway": "服务器原子地比较期望版本与当前版本；版本已经改变，就拒绝旧修改，不静默覆盖。",
  "reading_order": "从上往下沿三列读。本例画 A 先成功；两次读取的先后并非业务要求，换成 B 先提交，结果对称。",
  "boundary": "冲突检测不等于自动合并。B 需要先读取新版、比较改动，再决定如何重新提交；示例省略身份认证和权限检查。",
  "bindings": {
    "version": {
      "label": "当前版本",
      "definition_id": "lf-def-version",
      "meaning": "服务器目前持久保存的计划版本号",
      "source": "由成功提交原子递增",
      "example": "7 → 8"
    },
    "expected_version": {
      "label": "期望版本",
      "definition_id": "lf-def-expected-version",
      "meaning": "客户端提交修改时声明自己此前读到的版本",
      "source": "客户端读取后随保存请求发送",
      "example": "7"
    },
    "status_code": {
      "label": "响应状态码",
      "definition_id": "lf-def-conflict",
      "meaning": "409 在此示例表示版本冲突，200 表示请求成功",
      "source": "服务器返回",
      "example": "409：不覆盖当前版本"
    }
  },
  "actors": [
    {
      "id": "coach-a",
      "label": "教练 A"
    },
    {
      "id": "server",
      "label": "服务器"
    },
    {
      "id": "coach-b",
      "label": "教练 B"
    }
  ],
  "initial_state": {
    "version": 7
  },
  "expected_final": {
    "version": 8
  },
  "events": [
    {
      "id": "read-a",
      "type": "message",
      "from": "server",
      "to": "coach-a",
      "label": "读取计划",
      "payload": {
        "version": 7
      }
    },
    {
      "id": "read-b",
      "type": "message",
      "from": "server",
      "to": "coach-b",
      "label": "读取计划",
      "payload": {
        "version": 7
      }
    },
    {
      "id": "save-a",
      "type": "message",
      "from": "coach-a",
      "to": "server",
      "label": "提交修改",
      "payload": {
        "expected_version": 7
      },
      "after": [
        "read-a",
        "read-b"
      ]
    },
    {
      "id": "commit-a",
      "type": "compare_write",
      "actor": "server",
      "label": "原子比较与写入",
      "field": "version",
      "expected": 7,
      "value": 8,
      "after": [
        "save-a"
      ]
    },
    {
      "id": "reply-a",
      "type": "message",
      "from": "server",
      "to": "coach-a",
      "label": "返回保存结果",
      "result_of": "commit-a",
      "after": [
        "commit-a"
      ]
    },
    {
      "id": "save-b",
      "type": "message",
      "from": "coach-b",
      "to": "server",
      "label": "仍提交旧版修改",
      "payload": {
        "expected_version": 7
      },
      "after": [
        "commit-a",
        "read-b"
      ]
    },
    {
      "id": "reject-b",
      "type": "compare_write",
      "actor": "server",
      "label": "再次原子比较版本",
      "field": "version",
      "expected": 7,
      "value": 8,
      "after": [
        "save-b"
      ]
    },
    {
      "id": "reply-b",
      "type": "message",
      "from": "server",
      "to": "coach-b",
      "label": "返回结果，不覆盖 A",
      "result_of": "reject-b",
      "after": [
        "reject-b"
      ]
    }
  ]
}
